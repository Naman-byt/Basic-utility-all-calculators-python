print("Welcome to Grades Calculator")
print("available grades are A,B,C,D")

marks = float(input("Enter you marks percentage = "))

print("since your marks is = ",marks, "then,")

if marks >= 80 and marks <= 100:
    print(" ' A ' Grade- outstanding ")
elif marks <80 and marks >=60:
    print(" 'B' Grade- Good")
elif marks <60 and marks >= 40:
    print(" 'C' Grade- Too Average")
else:
    print('Try again and do better next time')
